{
  "name": "hfgs",
  "version": "2.0.1",
  "description": "HF Gaming Suite: bots, stats and history for HF's βytes games.",
  "private": true,
  "scripts": {
    "dev": "webpack --config=config/webpack.dev.ts",
    "build": "webpack --config=config/webpack.prod.ts",
    "package": "npm run build && node scripts/package.js",
    "assets:png": "node scripts/render-assets.js",
    "browser": "node scripts/browser.js",
    "browser:firefox": "node scripts/browser-firefox.js",
    "probe": "node scripts/probe.js",
    "capture": "node scripts/capture.js",
    "strategy:generate": "node scripts/generate-strategy-table.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.jest.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "author": "xadamxk",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@puppeteer/browsers": "^3.2.6",
    "@types/chrome": "^0.0.332",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.16.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.9.0"
  }
}
